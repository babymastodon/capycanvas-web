{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "capycanvas-web",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./docs",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "capycanvas.art", "zone_name": "capycanvas.art", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
